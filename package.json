{
  "name": "rsbuild-react",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "cross-env CROSS_ENV=dev rsbuild dev --open",
    "build:test": "cross-env CROSS_ENV=test rsbuild build",
    "build:uat": "cross-env CROSS_ENV=test rsbuild build",
    "build:prod": "cross-env CROSS_ENV=production rsbuild build",
    "preview": "rsbuild preview",
    "format": "prettier --write .",
    "prepare": "husky",
    "type-check": "tsc --noEmit",
    "lint": "eslint --ext .ts,.tsx src",
    "check": "npm run type-check && npm run lint && npm run build:test",
    "test": "npm run check"
  },
  "dependencies": {
    "axios": "^1.13.2",
    "mobx": "^6.13.7",
    "mobx-react": "^9.2.0",
    "react-router-dom": "6.28.2",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@rsbuild/core": "^1.1.8",
    "@rsbuild/plugin-eslint": "^1.1.1",
    "@rsbuild/plugin-react": "^1.0.7",
    "@rsbuild/plugin-sass": "^1.2.0",
    "@rsbuild/plugin-type-check": "^1.3.2",
    "@rspack/core": "^1.2.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@typescript-eslint/eslint-plugin": "^8.32.0",
    "@typescript-eslint/parser": "^8.32.0",
    "antd": "^5.27.4",
    "babel-plugin-react-compiler": "^1.0.0",
    "cross-env": "^7.0.3",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-prettier": "^5.4.0",
    "eslint-plugin-react": "^7.32.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "html-webpack-plugin": "^5.6.3",
    "husky": "^9.1.4",
    "lint-staged": "^15.2.10",
    "prettier": "^3.6.2",
    "typescript": "^5.7.2",
    "chalk": "^5.3.0"
  },
  "peerDependencies": {
   
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{js,jsx,md,json}": "prettier --write"
  }
}
